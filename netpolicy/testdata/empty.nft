table inet ringfence_a1 {
	set allow4 {
		type ipv4_addr . inet_proto . inet_service
	}
	set seen_ok {
		type ipv4_addr . inet_proto . inet_service
		flags dynamic
		size 4096
	}
	set seen_denied {
		type ipv4_addr . inet_proto . inet_service
		flags dynamic
		size 4096
	}
	set seen_denied_other {
		type ipv4_addr . inet_proto
		flags dynamic
		size 4096
	}
	chain egress {
		type filter hook forward priority filter - 1; policy accept;
		iifname "rfh0" meta nfproto ipv6 drop
		iifname "rfh0" ip saddr != 10.213.0.2 counter drop
		iifname "rfh0" ct state new meta l4proto { tcp, udp } ip daddr . meta l4proto . th dport @allow4 update @seen_ok { ip daddr . meta l4proto . th dport }
		iifname "rfh0" meta l4proto { tcp, udp } ip daddr . meta l4proto . th dport @allow4 accept
		iifname "rfh0" ct state new meta l4proto { tcp, udp } update @seen_denied { ip daddr . meta l4proto . th dport }
		iifname "rfh0" ct state new meta l4proto != { tcp, udp } update @seen_denied_other { ip daddr . meta l4proto }
		iifname "rfh0" counter drop
		oifname "rfh0" ct state established,related accept
		oifname "rfh0" counter drop
	}
	chain host_in {
		type filter hook input priority filter - 1; policy accept;
		iifname "rfh0" ip saddr != 10.213.0.2 counter drop
		iifname "rfh0" ct state new meta l4proto { tcp, udp } update @seen_denied { ip daddr . meta l4proto . th dport }
		iifname "rfh0" ct state new meta l4proto != { tcp, udp } update @seen_denied_other { ip daddr . meta l4proto }
		iifname "rfh0" counter drop
	}
	chain nat_out {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr 10.213.0.2 oifname != "rfh0" masquerade
	}
}
